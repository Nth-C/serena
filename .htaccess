RewriteEngine On
RewriteBase /

# 1. Empêcher le listage des répertoires
Options -Indexes

# 2. Sécurité : Forcer le HTTPS (souvent nécessaire sur Alwaysdata)
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 3. ROUTAGE BACKEND (PHP)
# Si l'URL commence par /backend ou s'il s'agit d'une route API connue
# On redirige vers votre index.php backend
RewriteCond %{REQUEST_URI} ^/(backend|api|home) [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

# 4. ROUTAGE FRONTEND (React)
# Pour toutes les autres routes, si le fichier n'existe pas, on sert le Frontend
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

<IfModule mod_headers.c>
    # Protection Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    # Protection MIME type (évite l'erreur 'Unexpected token export')
    Header always set X-Content-Type-Options "nosniff"
    # Protection XSS
    Header always set X-XSS-Protection "1; mode=block"
    # HSTS
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>